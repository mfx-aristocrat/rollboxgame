local Config = require("../src/shared/Config")
local Rules = require("../src/shared/RunRules")
local Progression = require("../src/shared/Progression")
local Profile = require("../src/shared/Profile")
local codec = Profile.createCodec(Config)

return function()
    local count = 0
    local function test(name, fn)
        local ok, err = pcall(fn)
        assert(ok, name .. ": " .. tostring(err))
        count += 1
    end
    local function completed()
        local run = Rules.start(0, "server_generated")
        for index, gate in Config.route.gates do
            if run.polarity ~= gate.polarity then assert(Rules.toggle(run, index * 5, Config)) end
            assert(Rules.gate(run, index, index * 5, Config))
        end
        assert(Rules.finish(run, 25, Config))
        return run
    end
    test("start state and polarity", function()
        local run = Rules.start(10, "id")
        assert(run.state == "Running" and run.nextGate == 1 and run.polarity == "Amber")
    end)
    test("toggle cooldown", function()
        local run = Rules.start(0, "id")
        assert(Rules.toggle(run, 0, Config))
        assert(not Rules.toggle(run, 0.49, Config))
        assert(run.polarity == "Cyan")
        assert(Rules.toggle(run, 0.5, Config))
        assert(run.polarity == "Amber")
    end)
    test("ordered gates only", function()
        local run = Rules.start(0, "id")
        assert(not Rules.gate(run, 2, 10, Config))
        assert(not Rules.gate(run, 0 / 0, 10, Config))
        assert(not Rules.gate(run, 9, 10, Config))
        assert(run.nextGate == 1)
    end)
    test("wrong polarity preserves checkpoint", function()
        local run = Rules.start(0, "id")
        assert(Rules.toggle(run, 1, Config))
        local ok, why = Rules.gate(run, 1, 5, Config)
        assert(not ok and why == "wrong_polarity" and run.nextGate == 1 and run.checkpoint == 0)
    end)
    test("duplicate gate cannot advance", function()
        local run = Rules.start(0, "id")
        assert(Rules.gate(run, 1, 5, Config))
        assert(not Rules.gate(run, 1, 6, Config))
        assert(run.nextGate == 2 and run.checkpoint == 1)
    end)
    test("implausible time rejected", function()
        local run = Rules.start(0, "id")
        assert(not Rules.gate(run, 1, 0.1, Config))
    end)
    test("early finish no reward", function()
        local run = Rules.start(0, "id")
        assert(not Rules.finish(run, 100, Config))
        local profile = codec.default()
        assert(not Progression.reward(profile, run, Config))
        assert(profile.coins == 0)
    end)
    test("complete run one reward", function()
        local run, profile = completed(), codec.default()
        assert(Progression.reward(profile, run, Config))
        assert(not Progression.reward(profile, run, Config))
        assert(not Rules.finish(run, 26, Config))
        assert(profile.coins == 25 and profile.completedRuns == 1 and profile.bestTimes.training == 25)
        assert(profile.tutorialComplete)
    end)
    test("slower time does not replace best", function()
        local profile = codec.default()
        profile.bestTimes.training = 20
        assert(Progression.reward(profile, completed(), Config))
        assert(profile.bestTimes.training == 20)
    end)
    test("invalid completion time cannot reward", function()
        local profile = codec.default()
        for _, invalid in { 0, -1, 0 / 0, math.huge, 3601, "25" } do
            local run = { state = "Completed", resultTime = invalid }
            assert(not Progression.reward(profile, run, Config))
        end
        assert(profile.coins == 0 and profile.completedRuns == 0)
    end)
    test("two runs buy and equip mint exactly once", function()
        local profile = codec.default()
        assert(Progression.reward(profile, completed(), Config))
        assert(not Progression.buyMint(profile, Config))
        assert(Progression.reward(profile, completed(), Config))
        assert(Progression.buyMint(profile, Config))
        assert(profile.coins == 0 and profile.cosmetics.mint)
        assert(not Progression.buyMint(profile, Config))
        assert(Progression.equip(profile, "mint"))
        assert(codec.validate(profile))
    end)
    test("unowned/invalid cosmetics rejected", function()
        local profile = codec.default()
        assert(not Progression.equip(profile, "mint"))
        assert(not Progression.equip(profile, "supporter"))
        assert(not Progression.equip(profile, {}))
        assert(profile.equippedCosmetic == "default")
    end)
    test("unlock boundaries", function()
        local profile = codec.default()
        assert(Progression.unlocked(profile, "training", Config))
        assert(not Progression.unlocked(profile, "rooftops", Config))
        profile.completedRuns = 3
        assert(Progression.unlocked(profile, "rooftops", Config))
        assert(not Progression.unlocked(profile, "skybridge", Config))
        profile.completedRuns = 10
        assert(Progression.unlocked(profile, "skybridge", Config))
        assert(not Progression.unlocked(profile, "invented", Config))
    end)
    test("aborted/expired runs cannot progress", function()
        local run = Rules.start(0, "id")
        Rules.abort(run)
        assert(not Rules.toggle(run, 1, Config))
        assert(not Rules.gate(run, 1, 1, Config))
        assert(not Rules.active(Rules.start(0, "id"), 3601, Config))
    end)
    test("malformed intents no profile mutation", function()
        for _, action in { {}, 8, true, "Award", string.rep("x", 100), "Finish" } do
            assert(not Rules.admitIntent(Rules.newLimiter(0), action, nil, 0))
        end
        assert(not Rules.admitIntent(Rules.newLimiter(0), "Start", { coins = 1000 }, 0))
    end)
    test("bounded intent spam and refill", function()
        local limiter = Rules.newLimiter(0)
        assert(Rules.admitIntent(limiter, "Switch", nil, 0))
        assert(Rules.admitIntent(limiter, "Switch", nil, 0))
        assert(not Rules.admitIntent(limiter, "Switch", nil, 0))
        assert(Rules.admitIntent(limiter, "Switch", nil, 0.5))
    end)
    test("invalid time never refills limiter", function()
        assert(not Rules.admitIntent(Rules.newLimiter(10), "Start", nil, 0 / 0))
        assert(not Rules.admitIntent(Rules.newLimiter(10), "Start", nil, 9))
    end)
    test("movement fences teleports", function()
        assert(Rules.validMovement({0,12,0}, {0,12,-2}, 0.1, Config))
        assert(not Rules.validMovement({0,12,0}, {0,12,-100}, 0.1, Config))
        assert(not Rules.validMovement({0,12,0}, {0,12,math.huge}, 0.1, Config))
    end)
    test("gate sweep direction and opening", function()
        local gate = Config.route.gates[1]
        assert(Rules.crossedGate({0,12,-23}, {0,12,-25}, gate))
        assert(not Rules.crossedGate({0,12,-25}, {0,12,-23}, gate))
        assert(not Rules.crossedGate({20,12,-23}, {20,12,-25}, gate))
    end)
    test("two players remain independent", function()
        local a, b = Rules.start(0, "a"), Rules.start(0, "b")
        assert(Rules.toggle(a, 1, Config))
        assert(b.polarity == "Amber" and b.nextGate == 1)
        local pa, pb = codec.default(), codec.default()
        Progression.reward(pa, completed(), Config)
        assert(pb.coins == 0)
    end)
    return count
end
